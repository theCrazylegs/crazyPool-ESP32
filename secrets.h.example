// NE PAS committer secrets.h sur GitHub !

// WiFi
#define WIFI_SSID         "VotreNomWifi"       // Nom de votre réseau WiFi
#define WIFI_PWD          "VotreMotDePasse"    // Mot de passe WiFi

// MQTT
#define MQTT_BROKER       "192.168.x.xxx"      // IP de votre broker MQTT (ex: Mosquitto)
#define MQTT_BROKER_PORT  1883
#define MQTT_USERNAME     "votre_user"         // Utilisateur MQTT
#define MQTT_KEY          "votre_mot_de_passe" // Mot de passe MQTT

// OTA (Over The Air updates) — mise à jour du firmware via WiFi sans câble USB
#define OTA_PASSWORD      "votre_mot_de_passe_ota" // Protège contre les flashs non autorisés
